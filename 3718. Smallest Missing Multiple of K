class Solution {
public:
  int missingMultiple(vector<int>& nums, int k) {
    for(int i = 0; i<nums.size(); i++){
      if(nums[i]%k == 0){
        nums[i] /= k;
      }
      else{
        nums[i] = 0;
      }
    }
    unordered_map<int,int> mp;
    for(int i : nums){
      mp[i]++;
    }
    int result = 1;
    while(mp[result] != 0)
      result++;
    return result*k;
  }
};
